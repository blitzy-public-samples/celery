          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "min(celery_global_rate_limit_up)",
          "legendFormat": "Limiter Connectivity / Readiness",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Token Acquisition Rate (allow / deny / fallback)",
      "description": "Per-second rate of allow/deny/fallback outcomes from the GlobalRateLimiter counters (allow_count, deny_count, fallback_count). ADDED telemetry. Expressions are illustrative, operator-supplied placeholders.",
