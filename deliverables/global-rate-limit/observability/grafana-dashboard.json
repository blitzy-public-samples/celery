{
  "id": null,
  "uid": "celery-global-rate-limit",
  "title": "Celery Global Rate Limiter",
  "description": "TEMPLATE dashboard for the opt-in, Redis-backed Celery global (cross-worker) rate limiter. Celery exposes NO metrics HTTP endpoint; the in-module GlobalRateLimiter counters (allow_count/deny_count/fallback_count), the fail-open WARNING log, and ping() readiness are in-process only. Operators must export them via their OWN pipeline (e.g. a statsd/Prometheus exporter or log-derived metrics). The PromQL expressions below (celery_global_rate_limit_*) are illustrative, operator-supplied placeholders, not metrics emitted by Celery core. See metrics.md for signal definitions.",
  "tags": [
    "celery",
    "rate-limit",
    "redis",
    "observability"
  ],
  "style": "dark",
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Data source",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(celery_global_rate_limit_allow_total, task)",
        "hide": 0,
        "includeAll": true,
        "label": "Task",
        "multi": true,
        "name": "task",
        "options": [],
        "query": {
          "query": "label_values(celery_global_rate_limit_allow_total, task)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Total Allowed",
      "description": "Cumulative count of token acquisitions GRANTED by the global limiter (GlobalRateLimiter.allow_count). ADDED telemetry. Operator-supplied Prometheus expression; Celery exposes no metrics endpoint.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(celery_global_rate_limit_allow_total)",
          "legendFormat": "Total Allowed",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Total Denied",
      "description": "Cumulative count of token acquisitions REFUSED by the global limiter (GlobalRateLimiter.deny_count); the task is deferred via the existing retry loop. ADDED telemetry.",
